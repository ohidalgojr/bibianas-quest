{
  "mcpServers": {
    "godot": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@coding-solo/godot-mcp@0.1.1"],
      "env": {
        "GODOT_PATH": "${GODOT_BIN}",
        "DEBUG": "false"
      }
    },
    "blender": {
      "command": "cmd",
      "args": ["/c", "uvx", "blender-mcp==2.0.0"]
    }
  }
}
